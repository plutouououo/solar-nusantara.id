---
/**
 * One article card, shared by /berita/ and /berita/[page].
 *
 * The two listing pages carried byte-identical copies of this markup. They had
 * already drifted once: both passed `alt={post.data.title}` to the hero image,
 * restating the headline instead of describing the picture, which is an empty
 * signal for screen readers and an Ahrefs/Semrush "non-descriptive alt" flag.
 * Fixed once here rather than twice there.
 */
import { Image } from 'astro:assets';
import type { Article } from '../utils/articles';

interface Props {
	post: Article;
	/** Eager-load the first card so the listing's LCP image is not lazy. */
	eager?: boolean;
}

const { post, eager = false } = Astro.props;
---

<a href={`/berita/${post.slug}/`} class="group block">
	<article
		class="bg-white p-6 rounded-xl shadow-lg hover:shadow-2xl transition-shadow duration-300 flex flex-col h-full"
	>
		{post.data.heroImage && (
			<div class="flex-shrink-0 mb-4">
				<Image
					src={post.data.heroImage}
					alt={post.data.heroImageAlt ?? post.data.title}
					width={600}
					height={338}
					class="w-full h-auto object-cover rounded-lg shadow-md"
					loading={eager ? 'eager' : 'lazy'}
				/>
			</div>
		)}
		<div class="flex-grow flex flex-col">
			<p class="text-sm font-semibold text-blue-600 mb-2">
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('id-ID', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</time>
			</p>
			<h2
				class="text-xl font-bold text-gray-900 group-hover:text-blue-700 transition-colors duration-300 flex-grow"
			>
				{post.data.title}
			</h2>
			<p class="mt-3 text-base text-gray-600 line-clamp-3">{post.data.description}</p>
			<div class="mt-4 font-semibold text-blue-600 flex items-center group-hover:text-blue-800">
				Baca Selengkapnya
				<span class="ml-2 transition-transform duration-300 group-hover:translate-x-2">&rarr;</span>
			</div>
		</div>
	</article>
</a>
