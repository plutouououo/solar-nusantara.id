---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import IntroPageMenu from '../../components/IntroPageMenu.astro';
import { navLinks, type NavLink } from '../../data/navLinks';

export async function getStaticPaths() {
  const entries = await getCollection('tentang');
  const parentLink = navLinks.find(link => link.href === '/tentang');
  
  const paths = [];

  // 1. Paths from Content Collections
  for (const entry of entries) {
    paths.push({
      params: { slug: entry.slug },
      props: { type: 'content', entry },
    });
  }

  // 2. Paths from navLinks (for hub pages)
  function extractHubPaths(links: NavLink[]) {
    for (const link of links) {
      if (link.href?.startsWith('/tentang/') && link.children) {
        const slug = link.href.substring('/tentang/'.length);
        if (!paths.find(p => p.params.slug === slug)) {
          paths.push({
            params: { slug },
            props: { type: 'hub', link },
          });
        }
      }
      if (link.children) extractHubPaths(link.children);
    }
  }

  if (parentLink?.children) {
    extractHubPaths(parentLink.children);
  }

  return paths;
}

const { slug } = Astro.params;
const { type, entry, link: hubLink } = Astro.props;

let title = '';
// Every page needs its own meta description. Falling back to the site-wide
// one made 50 pages share a single identical description.
let description = '';
let menuItems = [];
let Content = null;

if (type === 'content') {
  const rendered = await entry.render();
  Content = rendered.Content;
  title = entry.data.title;
  description = entry.data.description ?? '';
  
  const fullPath = `/tentang/${slug}`;
  const findInNav = (links: NavLink[]): NavLink | undefined => {
    for (const l of links) {
      if (l.href === fullPath) return l;
      if (l.children) {
        const found = findInNav(l.children);
        if (found) return found;
      }
    }
  };
  const navItem = findInNav(navLinks);
  menuItems = navItem?.children || [];
} else {
  title = hubLink?.text || 'Tentang';
  menuItems = hubLink?.children || [];
  // Hub pages have no body text to summarise, so the description is built from
  // what the page actually lists. Unique per hub, and accurate.
  const names = menuItems.map((i: NavLink) => i.text).slice(0, 4).join(', ');
  description = names
    ? `Informasi ${title} dari Solar Nusantara: ${names}. Perusahaan energi surya untuk kebutuhan residensial, komersial, dan industri di Indonesia.`
    : `${title} dari Solar Nusantara, perusahaan energi surya untuk kebutuhan residensial, komersial, dan industri di Indonesia.`;
}
---

<Layout title={title} description={description || undefined}>
  <div class="container mx-auto px-4 py-12">
    {Content ? (
      <article class="prose prose-lg max-w-4xl mx-auto">
        <h1>{title}</h1>
        <Content />
        
        {menuItems.length > 0 && (
          <div class="mt-16 pt-8 border-t">
            <h2 class="text-2xl font-bold mb-6">Lanjut Membaca</h2>
            <div class="grid md:grid-cols-2 gap-4">
              {menuItems.map(item => (
                <a href={item.href} class="p-4 border rounded-lg hover:border-blue-600 hover:bg-blue-50 transition-all">
                  <h3 class="font-semibold text-blue-600">{item.text}</h3>
                </a>
              ))}
            </div>
          </div>
        )}
      </article>
    ) : (
      <IntroPageMenu title={title} items={menuItems} />
    )}
  </div>
</Layout>
