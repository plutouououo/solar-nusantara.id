---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png'; // Assuming this is the 'solar nusantara' logo
---

<Layout
  title="Halaman Tidak Ditemukan"
  description="Halaman yang Anda cari tidak ditemukan di solar-nusantara.id. Kembali ke beranda untuk menelusuri layanan, produk, dan berita energi surya kami."
>
  {/*
    Was `min-h-[calc(100vh-theme(spacing.20)-theme(spacing.20))]`. That is
    Tailwind's `theme()` function, but this project builds with UnoCSS - see
    astro.config.mjs, which loads `unocss/astro` and no Tailwind integration
    (tailwind.config.mjs is a dead leftover; Tailwind is not even a dependency).
    UnoCSS could not resolve `spacing.20` and failed the entire build with
    "theme of spacing.20 did not found", so no page could be generated at all.
    Tailwind's spacing.20 is 5rem, twice is 10rem - same result, no theme lookup.
  */}
  <div class="flex flex-col items-center justify-center min-h-[calc(100vh-10rem)] px-4 py-16 text-center">
    <Image 
      src={logo} 
      alt="Solar Nusantara Logo" 
      width={200} 
      height={200} 
      class="mb-8"
    />
    <h1 class="text-6xl font-bold text-gray-800 mb-4">404</h1>
    <p class="text-xl text-gray-600 mb-8">Maaf, halaman yang Anda cari tidak ditemukan.</p>
    <a 
      href="/" 
      class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-150 ease-in-out"
    >
      Kembali ke Beranda
    </a>
  </div>
</Layout>