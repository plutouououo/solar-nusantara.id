---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles, type Article } from '../../utils/articles';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getPublishedArticles();
  return paginate(posts, { pageSize: 6 })
    // Page 1 already lives at /berita/ via index.astro, so the paginated copy
    // at /berita/1/ is the same six cards on a second URL.
    //
    // This filter used to read `p.params.page !== 1`. `paginate()` fills
    // `params.page` with a STRING, so '1' !== 1 was always true, the filter
    // removed nothing, and /berita/1/ shipped in the sitemap as a duplicate of
    // /berita/. Filtering on `props.page.currentPage` compares a real number
    // and does not depend on how the param happens to be typed.
    .filter((p) => p.props.page.currentPage !== 1);
};

type Props = { page: Page<Article> };
const { page } = Astro.props;

// Page 2's "previous" is /berita/1, which does not exist - send it to /berita/.
const prevUrl = page.url.prev === '/berita/1' ? '/berita' : page.url.prev;
---

<Layout
  title={`Berita & Wawasan - Halaman ${page.currentPage}`}
  description={`Artikel dan panduan teknis energi surya dari Solar Nusantara, halaman ${page.currentPage} dari ${page.lastPage}: perhitungan PLTS, efisiensi panel, dan industri fotovoltaik.`}
>
  <main class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight">Berita & Wawasan</h1>
      <p class="text-lg md:text-xl text-gray-600">
        Ikuti perkembangan terbaru, proyek, dan inovasi dari Solar Nusantara.
      </p>
    </div>

    <div class="max-w-7xl mx-auto mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {page.data.map((post, i) => <ArticleCard post={post} eager={i < 2} />)}
    </div>

    <nav class="max-w-7xl mx-auto mt-16 flex justify-between items-center" aria-label="Navigasi halaman">
      <div>
        {prevUrl && (
          <a href={prevUrl} rel="prev" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-300">
            &larr; Halaman Sebelumnya
          </a>
        )}
      </div>
      <div class="text-gray-600">
        Halaman {page.currentPage} dari {page.lastPage}
      </div>
      <div>
        {page.url.next && (
          <a href={page.url.next} rel="next" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-300">
            Halaman Berikutnya &rarr;
          </a>
        )}
      </div>
    </nav>
  </main>
</Layout>
