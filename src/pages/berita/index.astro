---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../utils/articles';

const allPosts = await getPublishedArticles();

const pageSize = 6;
const pageCount = Math.ceil(allPosts.length / pageSize);
const posts = allPosts.slice(0, pageSize);

const page = {
  data: posts,
  currentPage: 1,
  lastPage: pageCount,
  url: {
    prev: undefined,
    next: pageCount > 1 ? '/berita/2' : undefined,
  }
};
---

<Layout
  title="Berita & Wawasan Energi Surya"
  description="Artikel dan panduan teknis energi surya dari Solar Nusantara: perhitungan sistem PLTS, efisiensi panel, komponen, dan perkembangan industri fotovoltaik."
>
  <main class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight">Berita & Wawasan</h1>
      <p class="text-lg md:text-xl text-gray-600">
        Ikuti perkembangan terbaru, proyek, dan inovasi dari Solar Nusantara.
      </p>
    </div>

    <div class="max-w-7xl mx-auto mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {page.data.map((post, i) => <ArticleCard post={post} eager={i < 2} />)}
    </div>

    <nav class="max-w-7xl mx-auto mt-16 flex justify-between items-center" aria-label="Navigasi halaman">
      <div>
        {page.url.prev && (
          <a href={page.url.prev} class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-300">
            &larr; Halaman Sebelumnya
          </a>
        )}
      </div>
      <div class="text-gray-600">
        Halaman {page.currentPage} dari {page.lastPage}
      </div>
      <div>
        {page.url.next && (
          <a href={page.url.next} rel="next" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-300">
            Halaman Berikutnya &rarr;
          </a>
        )}
      </div>
    </nav>
  </main>
</Layout>
